@model Models.VM.CreateProductVM

@{
    ViewData["Title"] = "Edit Product";
    ViewData["PageTitle"] = "Edit Product";
    ViewData["PageDescription"] = "Update product";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="/css/Admin/products.css" />

<section class="product-form-page">
    <div class="product-form-card">

        <div style="display:flex; gap:20px; flex-wrap:wrap; margin-bottom:20px;">

            <div>
                <label style="font-weight:600;">Main Product Image</label><br />

                @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                {
                    <img id="imagePreview"
                         src="@Model.ExistingImageUrl"
                         style="width:120px; height:120px; object-fit:cover; border-radius:12px; margin-top:10px; border: 2px solid #ddd;" />
                }
                else
                {
                    <img id="imagePreview"
                         src="/images/category-placeholder.png"
                         style="width:120px; height:120px; object-fit:cover; border-radius:12px; margin-top:10px; border: 2px solid #ddd;" />
                }
            </div>

            <div>
                <label style="font-weight:600;">Try-On Video</label><br />

                @if (!string.IsNullOrEmpty(Model.ExistingTryOnGifUrl))
                {
                    <video id="videoPreview"
                           src="@Model.ExistingTryOnGifUrl"
                           controls
                           muted
                           loop
                           playsinline
                           style="width:120px; height:120px; object-fit:cover; border-radius:12px; margin-top:10px; border: 2px solid #ddd;">
                    </video>
                }
                else
                {
                    <video id="videoPreview"
                           controls
                           muted
                           loop
                           playsinline
                           style="width:120px; height:120px; object-fit:cover; border-radius:12px; margin-top:10px; border: 2px solid #ddd; background:#f1f1f1;">
                    </video>
                }
            </div>

            <div id="additionalImagesPreviewContainer" style="display:none;">
                <label style="font-weight:600;">New Additional Images Preview</label><br />
                <div id="additionalImagesPreview"
                     style="display:flex; gap:10px; flex-wrap:wrap; margin-top:10px;">
                </div>
            </div>

        </div>

        @if (Model.ExistingProductImages != null && Model.ExistingProductImages.Any())
        {
            <div style="margin-bottom:25px;">
                <label style="font-weight:700; display:block; margin-bottom:10px;">
                    Existing Additional Images
                </label>

                <div style="display:flex; gap:14px; flex-wrap:wrap;">
                    @foreach (var image in Model.ExistingProductImages)
                    {
                        <div style="
                            position:relative;
                            width:120px;
                            border:1px solid #eee;
                            border-radius:14px;
                            padding:8px;
                            background:#fff;
                            box-shadow:0 6px 16px rgba(0,0,0,0.06);">

                            <img src="@image.ImageUrl"
                                 style="width:100%; height:95px; object-fit:cover; border-radius:10px;" />

                            <form asp-action="DeleteProductImage"
                                  method="post"
                                  style="margin-top:8px;"
                                  onsubmit="return confirm('Delete this image?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="imageId" value="@image.Id" />
                                <input type="hidden" name="productId" value="@Model.Id" />

                                <button type="submit"
                                        style="
                                    width:100%;
                                    border:none;
                                    background:#e11d48;
                                    color:white;
                                    border-radius:9px;
                                    padding:6px;
                                    font-size:12px;
                                    font-weight:700;
                                    cursor:pointer;">
                                    Delete
                                </button>
                            </form>

                        </div>
                    }
                </div>
            </div>
        }

        <form asp-action="Edit" method="post" enctype="multipart/form-data">

            <input asp-for="Id" type="hidden" />
            <input asp-for="ExistingImageUrl" type="hidden" />
            <input asp-for="ExistingTryOnGifUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-input form-textarea"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-input" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Gender">Gender</label>
                <select asp-for="Gender" asp-items="Model.GenderList" class="form-input">
                    <option value="">-- Select Target Audience --</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId">Category</label>
                <select asp-for="CategoryId" asp-items="Model.CategoriesList" class="form-input">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageFile">Change Main Image (optional)</label>
                <input asp-for="ImageFile"
                       type="file"
                       class="form-input"
                       id="imageInput"
                       accept="image/*" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AdditionalImages">Add More Product Images</label>
                <input asp-for="AdditionalImages"
                       type="file"
                       class="form-input"
                       id="additionalImagesInput"
                       accept="image/*"
                       multiple />

                <span asp-validation-for="AdditionalImages" class="text-danger"></span>

                <small style="display:block; margin-top:6px; color:#777;">
                    You can upload more images without deleting the old ones.
                </small>
            </div>

            <div class="form-group">
                <label asp-for="ColorsText">Product Colors</label>
                <input asp-for="ColorsText"
                       class="form-input"
                       placeholder="Example: Red, Black, White, Navy Blue" />

                <span asp-validation-for="ColorsText" class="text-danger"></span>

                <small style="display:block; margin-top:6px; color:#777;">
                    Write colors separated by commas only. Example: Red, Black, White
                </small>
            </div>

            <div class="form-group">
                <label asp-for="TryOnGifFile">Change Try-On Video (optional)</label>
                <input asp-for="TryOnGifFile"
                       type="file"
                       class="form-input"
                       id="videoInput"
                       accept="video/mp4,video/webm,video/quicktime" />
                <span asp-validation-for="TryOnGifFile" class="text-danger"></span>

                <small style="display:block; margin-top:6px; color:#777;">
                    Upload a short video showing a model wearing this product.
                </small>
            </div>

            <div class="form-buttons">
                <button type="submit" class="save-btn">Update</button>
                <a asp-action="Index" class="cancel-btn">Back to List</a>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const imageInput = document.getElementById('imageInput');
        const imagePreview = document.getElementById('imagePreview');

        const videoInput = document.getElementById('videoInput');
        const videoPreview = document.getElementById('videoPreview');

        const additionalImagesInput = document.getElementById('additionalImagesInput');
        const additionalImagesPreview = document.getElementById('additionalImagesPreview');
        const additionalImagesPreviewContainer = document.getElementById('additionalImagesPreviewContainer');

        imageInput.addEventListener('change', function () {
            const file = this.files[0];

            if (file) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    imagePreview.src = e.target.result;
                };

                reader.readAsDataURL(file);
            }
        });

        videoInput.addEventListener('change', function () {
            const file = this.files[0];

            if (file) {
                videoPreview.src = URL.createObjectURL(file);
                videoPreview.load();
            }
        });

        additionalImagesInput.addEventListener('change', function () {
            const files = Array.from(this.files);

            additionalImagesPreview.innerHTML = '';

            if (files.length > 0) {
                additionalImagesPreviewContainer.style.display = 'block';

                files.forEach(file => {
                    const reader = new FileReader();

                    reader.onload = function (e) {
                        const img = document.createElement('img');

                        img.src = e.target.result;
                        img.style.width = '90px';
                        img.style.height = '90px';
                        img.style.objectFit = 'cover';
                        img.style.borderRadius = '10px';
                        img.style.border = '2px solid #ddd';

                        additionalImagesPreview.appendChild(img);
                    };

                    reader.readAsDataURL(file);
                });
            } else {
                additionalImagesPreviewContainer.style.display = 'none';
            }
        });
    </script>
}