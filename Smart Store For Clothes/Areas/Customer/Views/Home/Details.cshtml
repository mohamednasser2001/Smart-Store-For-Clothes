@model Models.VM.CustomerProductDetailsVM

@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<link rel="stylesheet" href="/css/Customer/product-details.css" />

<div class="container-fluid" style="padding:40px; background:#f7f8fc; min-height:100vh;">

    <!-- PRODUCT SECTION -->
    <div class="row bg-white p-4 rounded shadow-sm">

        <!-- IMAGE -->
        <div class="col-md-5">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/category-placeholder.png" : Model.ImageUrl)"
                 style="width:100%; max-height:620px; object-fit:cover; border-radius:15px;" />
        </div>

        <!-- INFO -->
        <div class="col-md-7">

            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <h2 style="margin-bottom:5px;">@Model.Name</h2>
                    <div style="color:gray;">@Model.CategoryName</div>
                </div>

                <div>
                    @if (Model.Reviews != null && Model.Reviews.Any())
                    {
                        <strong style="color:#f5b400;">
                            ★ @Model.AverageRating.ToString("0.0")
                        </strong>
                        <span style="color:gray;">(@Model.ReviewsCount)</span>
                    }
                    else
                    {
                        <span style="color:gray;">No rating</span>
                    }
                </div>
            </div>

            <h3 style="margin:15px 0;">
                $@Model.Price.ToString("0.00")
            </h3>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p>@Model.Description</p>
            }

            <!-- SIZES -->
            <h5 style="margin-top:20px;">Sizes</h5>

            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                @if (Model.Sizes != null && Model.Sizes.Any())
                {
                    foreach (var s in Model.Sizes)
                    {
                        <button type="button"
                                class="btn btn-light size-btn"
                                data-size-id="@s.SizeId">
                            @s.SizeName
                        </button>
                    }
                }
                else
                {
                    <p>No sizes available.</p>
                }
            </div>

            <form asp-area="Customer"
                  asp-controller="Cart"
                  asp-action="AddToCart"
                  method="post"
                  class="mt-3"
                  id="addToCartForm">

                @Html.AntiForgeryToken()

                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="sizeId" id="sizeId" />
                <input type="hidden" name="quantity" value="1" />

                <button type="submit" class="btn btn-success px-4">
                    Add to Cart
                </button>
            </form>

        </div>
    </div>

    <div style="height:30px;"></div>

    <!-- REVIEWS + ADD REVIEW -->
    <div class="row">

        <!-- REVIEWS LIST -->
        <div class="col-md-8">
            <div class="bg-white p-4 rounded shadow-sm">

                <h4 style="margin-bottom:20px;">Customer Reviews</h4>

                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    foreach (var r in Model.Reviews)
                    {
                        var displayName = string.IsNullOrWhiteSpace(r.UserName) ? "User" : r.UserName;
                        var firstLetter = displayName.Substring(0, 1).ToUpper();

                        <div style="border-bottom:1px solid #eee; padding:18px 0;">

                            <div style="display:flex; gap:14px; align-items:flex-start;">

                                <!-- USER AVATAR -->
                                <div style="
                                    width:46px;
                                    height:46px;
                                    min-width:46px;
                                    border-radius:50%;
                                    background:#111827;
                                    color:white;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    font-weight:bold;
                                    font-size:18px;">
                                    @firstLetter
                                </div>

                                <div style="flex:1;">

                                    <div style="display:flex; justify-content:space-between; align-items:center;">
                                        <strong style="font-size:15px;">@displayName</strong>
                                        <small style="color:gray;">@r.CreatedAt.ToString("dd/MM/yyyy")</small>
                                    </div>

                                    <div style="margin:5px 0;">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span style="color:@(i <= r.Rating ? "gold" : "#ddd"); font-size:18px;">
                                                ★
                                            </span>
                                        }
                                    </div>

                                    <p style="margin:0; color:#444;">
                                        @r.Comment
                                    </p>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <p style="color:gray;">No reviews yet</p>
                }

            </div>
        </div>

        <!-- ADD REVIEW -->
        <div class="col-md-4">
            <div class="bg-white p-4 rounded shadow-sm">

                <h4 style="margin-bottom:20px;">Add Review</h4>

                @if (TempData["ReviewSuccess"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["ReviewSuccess"]
                    </div>
                }

                @if (TempData["ReviewError"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["ReviewError"]
                    </div>
                }

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-area="Customer"
                          asp-controller="Home"
                          asp-action="AddReview"
                          method="post"
                          id="addReviewForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="rating" id="selectedRating" value="" />

                        <!-- CLICKABLE STARS -->
                        <div style="margin-bottom:12px;">
                            <label style="font-weight:bold;">Rating</label>

                            <div id="starRating"
                                 style="font-size:34px; cursor:pointer; line-height:1; margin-top:5px;">

                                <span data-value="1" style="color:#ddd;">★</span>
                                <span data-value="2" style="color:#ddd;">★</span>
                                <span data-value="3" style="color:#ddd;">★</span>
                                <span data-value="4" style="color:#ddd;">★</span>
                                <span data-value="5" style="color:#ddd;">★</span>

                            </div>

                            <small id="ratingError" style="color:red; display:none;">
                                Please select rating
                            </small>
                        </div>

                        <!-- COMMENT -->
                        <div style="margin-bottom:12px;">
                            <label style="font-weight:bold;">Comment</label>

                            <textarea name="comment"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Write your review..."
                                      required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Submit Review
                        </button>

                    </form>
                }
                else
                {
                    <div class="alert alert-warning">
                        You must login to write a review.
                    </div>

                    <a href="/Identity/Account/Login?ReturnUrl=@Uri.EscapeDataString(returnUrl)"
                       class="btn btn-primary w-100 mb-2">
                        Login
                    </a>

                    <a href="/Identity/Account/Register"
                       class="btn btn-outline-primary w-100">
                        Register
                    </a>
                }

            </div>
        </div>

    </div>

</div>

<script>
    const sizeButtons = document.querySelectorAll(".size-btn");
    const sizeInput = document.getElementById("sizeId");
    const addToCartForm = document.getElementById("addToCartForm");

    sizeButtons.forEach(btn => {
        btn.addEventListener("click", function () {
            sizeButtons.forEach(b => b.classList.remove("active"));
            this.classList.add("active");
            sizeInput.value = this.dataset.sizeId;
        });
    });

    if (addToCartForm) {
        addToCartForm.addEventListener("submit", function (e) {
            if (!sizeInput.value) {
                e.preventDefault();
                alert("Please select a size first.");
            }
        });
    }

    const stars = document.querySelectorAll("#starRating span");
    const selectedRatingInput = document.getElementById("selectedRating");
    const ratingError = document.getElementById("ratingError");
    const addReviewForm = document.getElementById("addReviewForm");

    stars.forEach(star => {
        star.addEventListener("click", function () {
            const rating = Number(this.dataset.value);
            selectedRatingInput.value = rating;

            stars.forEach(s => {
                s.style.color = Number(s.dataset.value) <= rating ? "gold" : "#ddd";
            });

            ratingError.style.display = "none";
        });
    });

    if (addReviewForm) {
        addReviewForm.addEventListener("submit", function (e) {
            if (!selectedRatingInput.value) {
                e.preventDefault();
                ratingError.style.display = "block";
            }
        });
    }
</script>