</style>

<script>
    const heightInput = document.getElementById('heightInput');
    const weightInput = document.getElementById('weightInput');
    const ageInput = document.getElementById('ageInput');
    const categorySelect = document.getElementById('categorySelect');
    const genderSelect = document.getElementById('genderSelect');

    const productsContainer = document.getElementById('productsContainer');
    const recommendedSizeBox = document.getElementById('recommendedSizeBox');

    async function filterProducts() {

        const productsLoading = document.getElementById('productsLoading');

        productsLoading.style.display = 'flex';
        productsContainer.style.opacity = '0.35';

        const height = heightInput.value;
        const weight = weightInput.value;
        const age = ageInput.value;
        const categoryId = categorySelect.value;
        const gender = genderSelect.value;

        const params = new URLSearchParams();

        if (height) params.append('height', height);
        if (weight) params.append('weight', weight);
        if (age) params.append('age', age);
        if (categoryId) params.append('categoryId', categoryId);
        if (gender) params.append('gender', gender);

        try {
            const response = await fetch(`/Customer/Home/FilterProducts?${params.toString()}`);
            const data = await response.json();

            if (data.recommendedSize) {
                recommendedSizeBox.style.display = 'block';
                recommendedSizeBox.textContent = `Recommended Size: ${data.recommendedSize}`;
            } else {
                recommendedSizeBox.style.display = 'none';
            }

            productsContainer.innerHTML = '';

            if (!data.products || data.products.length === 0) {
                productsContainer.innerHTML = `
                    <div class="empty-products">
                        <h3>No Products Found</h3>
                        <p>No products match your current filters.</p>
                    </div>
                `;

                updateCompareButtons();
                attach3DTilt();
                return;
            }

            data.products.forEach(product => {

                let starsHtml = '';

                if (product.reviewsCount > 0) {
                    const rounded = Math.round(product.averageRating);

                    for (let i = 1; i <= 5; i++) {
                        starsHtml += `<span style="color:${i <= rounded ? 'gold' : '#ddd'}; font-size:14px;">★</span>`;
                    }
                }

                const imageUrl = product.imageUrl || '/images/category-placeholder.png';

                const safeName = escapeHtml(product.name);
                const safeCategory = escapeHtml(product.categoryName);
                const safeGender = escapeHtml(product.gender);

                productsContainer.innerHTML += `
                    <div class="product-card-wrapper">

                        <a href="/Customer/Home/Details/${product.id}?height=${height || ''}&weight=${weight || ''}&age=${age || ''}"
                           class="product-card-link">

                            <div class="customer-product-card">

                                <div class="customer-product-image" style="position:relative;">
                                    <span class="gender-badge">${safeGender}</span>
                                    <img src="${escapeAttribute(imageUrl)}" />
                                </div>

                                <div class="customer-product-body">

                                    <div class="customer-product-category">${safeCategory}</div>

                                    <div class="customer-product-name">${safeName}</div>

                                    <div style="margin:6px 0; font-size:13px;">

                                        ${product.reviewsCount > 0
                                            ? `
                                                <div>${starsHtml}</div>
                                                <small style="color:gray;">
                                                    ${product.averageRating.toFixed(1)} / 5 (${product.reviewsCount})
                                                </small>
                                            `
                                            : `<small style="color:gray;">No reviews yet</small>`
                                        }

                                    </div>

                                    <div class="customer-product-price">
                                        $${Number(product.price).toFixed(2)}
                                    </div>

                                </div>

                            </div>

                        </a>

                        <button type="button"
                                class="favorite-btn ${product.isFavorite ? 'active' : ''}"
                                data-product-id="${product.id}"
                                title="Add to favorites">
                            ${product.isFavorite ? '♥' : '♡'}
                        </button>

                        <button type="button"
                                class="compare-btn"
                                data-product-id="${product.id}">
                            ⇄ Compare
                        </button>

                    </div>
                `;
            });

            updateCompareButtons();
            attach3DTilt();

        } finally {
            setTimeout(() => {
                productsLoading.style.display = 'none';
                productsContainer.style.opacity = '1';
            }, 350);
        }
    }

    let typingTimer;

    function debounceFilter() {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(filterProducts, 350);
    }

    heightInput.addEventListener('input', debounceFilter);
    weightInput.addEventListener('input', debounceFilter);
    ageInput.addEventListener('input', debounceFilter);
    categorySelect.addEventListener('change', filterProducts);
    genderSelect.addEventListener('change', filterProducts);

    function escapeHtml(value) {
        if (value == null) {
            return "";
        }

        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function escapeAttribute(value) {
        return escapeHtml(value);
    }
</script>

<script>
    const compareFloatingBar = document.getElementById("compareFloatingBar");
    const compareCountText = document.getElementById("compareCountText");
    const clearCompareBtn = document.getElementById("clearCompareBtn");
    const goCompareBtn = document.getElementById("goCompareBtn");

    function getCompareProducts() {
        const saved = localStorage.getItem("smartStoreCompareProducts");

        if (!saved) {
            return [];
        }

        try {
            return JSON.parse(saved);
        } catch {
            return [];
        }
    }

    function saveCompareProducts(products) {
        localStorage.setItem("smartStoreCompareProducts", JSON.stringify(products));
    }

    function updateCompareButtons() {
        const selectedProducts = getCompareProducts();

        document.querySelectorAll(".compare-btn").forEach(button => {
            const productId = button.dataset.productId;

            if (selectedProducts.includes(productId)) {
                button.classList.add("selected");
                button.innerText = "✓ Selected";
            } else {
                button.classList.remove("selected");
                button.innerText = "⇄ Compare";
            }
        });

        if (selectedProducts.length > 0) {
            compareFloatingBar.style.display = "flex";
            compareCountText.innerText = `${selectedProducts.length} product${selectedProducts.length > 1 ? "s" : ""} selected`;
        } else {
            compareFloatingBar.style.display = "none";
        }
    }

    document.addEventListener("click", function (e) {
        if (!e.target.classList.contains("compare-btn")) {
            return;
        }

        const productId = e.target.dataset.productId;
        let selectedProducts = getCompareProducts();

        if (selectedProducts.includes(productId)) {
            selectedProducts = selectedProducts.filter(id => id !== productId);
        } else {
            if (selectedProducts.length >= 3) {
                alert("You can compare up to 3 products only.");
                return;
            }

            selectedProducts.push(productId);
        }

        saveCompareProducts(selectedProducts);
        updateCompareButtons();
    });

    clearCompareBtn.addEventListener("click", function () {
        localStorage.removeItem("smartStoreCompareProducts");
        updateCompareButtons();
    });

    goCompareBtn.addEventListener("click", function () {
        const selectedProducts = getCompareProducts();

        if (selectedProducts.length < 2) {
            alert("Please select at least 2 products to compare.");
            return;
        }

        window.location.href = `/Customer/Home/Compare?ids=${selectedProducts.join(",")}`;
    });

    updateCompareButtons();
</script>

<script>
    function attach3DTilt() {
        document.querySelectorAll(".customer-product-card").forEach(card => {

            if (card.dataset.tiltAttached === "true") {
                return;
            }

            card.dataset.tiltAttached = "true";

            card.style.transition = "transform 0.08s ease, box-shadow 0.2s ease";

            card.addEventListener("mousemove", function (e) {
                const rect = card.getBoundingClientRect();

                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const rotateX = ((y - centerY) / centerY) * -18;
                const rotateY = ((x - centerX) / centerX) * 18;

                card.style.transform = `
                    translateY(-24px)
                    scale(1.07)
                    rotateX(${rotateX}deg)
                    rotateY(${rotateY}deg)
                `;

                card.style.boxShadow = "0 35px 80px rgba(108, 92, 231, 0.35)";
            });

            card.addEventListener("mouseleave", function () {
                card.style.transform = "";
                card.style.boxShadow = "";
            });
        });
    }

    const quickCompareBtn = document.getElementById("quickCompareBtn");
    const scrollTopBtn = document.getElementById("scrollTopBtn");

    quickCompareBtn.addEventListener("click", function () {
        const selectedProducts = getCompareProducts();

        if (selectedProducts.length < 2) {
            alert("Please select at least 2 products to compare.");
            return;
        }

        window.location.href = `/Customer/Home/Compare?ids=${selectedProducts.join(",")}`;
    });

    scrollTopBtn.addEventListener("click", function () {
        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    });

    attach3DTilt();
</script>

<script>
    document.addEventListener("click", async function (e) {
        const favoriteButton = e.target.closest(".favorite-btn");

        if (!favoriteButton) {
            return;
        }

        e.preventDefault();
        e.stopPropagation();

        const productId = favoriteButton.dataset.productId;

        try {
            const response = await fetch(`/Customer/Favorites/Toggle?productId=${productId}`, {
                method: "POST"
            });

            const data = await response.json();

            if (!data.success) {
                alert(data.message || "Please login first.");
                window.location.href = "/Identity/Account/Login?ReturnUrl=/Customer/Home/Index";
                return;
            }

            if (data.isFavorite) {
                favoriteButton.classList.add("active");
                favoriteButton.innerText = "♥";
            } else {
                favoriteButton.classList.remove("active");
                favoriteButton.innerText = "♡";
            }

        } catch {
            alert("Something went wrong while updating favorites.");
        }
    });
</script>

<!-- ================= AI CHAT WIDGET ================= -->

<button class="ai-chat-button" id="aiChatToggle">
    🤖
</button>

<div class="ai-chat-box" id="aiChatBox">

    <div class="ai-chat-header">
        <span>AI Assistant</span>
        <button id="aiChatClose" style="background:none; border:none; color:white; font-size:18px; cursor:pointer;">
            ×
        </button>
    </div>

    <div class="ai-chat-messages" id="aiChatMessages">
        <div class="ai-message ai-bot-message">
            Hi 👋 How can I help you today?
        </div>
    </div>

    <div class="ai-chat-input">
        <input type="text"
               id="aiMessageInput"
               placeholder="Ask about products, sizes, colors..." />

        <button type="button" id="aiSendBtn">
            Send
        </button>
    </div>

</div>

<script>
    const aiChatToggle = document.getElementById("aiChatToggle");
    const aiChatBox = document.getElementById("aiChatBox");
    const aiChatClose = document.getElementById("aiChatClose");
    const aiSendBtn = document.getElementById("aiSendBtn");
    const aiMessageInput = document.getElementById("aiMessageInput");
    const aiChatMessages = document.getElementById("aiChatMessages");

    aiChatToggle.addEventListener("click", function () {
        aiChatBox.style.display = "flex";
    });

    aiChatClose.addEventListener("click", function () {
        aiChatBox.style.display = "none";
    });

    aiSendBtn.addEventListener("click", sendAiMessage);

    aiMessageInput.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
            sendAiMessage();
        }
    });

    async function sendAiMessage() {
        const message = aiMessageInput.value.trim();

        if (!message) {
            return;
        }

        appendMessage(message, "user");
        aiMessageInput.value = "";

        appendMessage("Typing...", "bot", true);

        try {
            const response = await fetch("/Customer/AIChat/SendMessage", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    message: message
                })
            });

            const data = await response.json();

            removeTypingMessage();

            if (data.success) {
                appendMessage(data.reply, "bot");
            } else {
                appendMessage(data.reply || "Something went wrong.", "bot");
            }

        } catch (error) {
            removeTypingMessage();
            appendMessage("AI service is not available right now.", "bot");
        }
    }

    function appendMessage(text, sender, isTyping = false) {
        const div = document.createElement("div");

        div.classList.add("ai-message");

        if (sender === "user") {
            div.classList.add("ai-user-message");
        } else {
            div.classList.add("ai-bot-message");
        }

        if (isTyping) {
            div.id = "aiTypingMessage";
        }

        div.innerText = text;

        aiChatMessages.appendChild(div);
        aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
    }

    function removeTypingMessage() {
        const typing = document.getElementById("aiTypingMessage");

        if (typing) {
            typing.remove();
        }
    }
</script>