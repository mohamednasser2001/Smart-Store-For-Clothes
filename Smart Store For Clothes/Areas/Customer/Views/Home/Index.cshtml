@model Models.VM.CustomerProductFilterVM

@{
    ViewData["Title"] = "Products";
}

<link rel="stylesheet" href="/css/Customer/customer-home.css" />

<section class="customer-page">

    <div class="customer-header">
        <h1>Discover Our Products</h1>
        <p>Find the perfect product for your style and your size.</p>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a href="/Customer/Favorites/Index" class="my-favorites-link">
                ♥ My Favorites
            </a>
        }
    </div>

    <div class="smart-products-hero">

        <div class="smart-hero-content">
            <div class="smart-hero-badge">
                ✨ Smart Shopping Mode
            </div>

            <h2>
                Explore fashion in a smarter, faster, and more exciting way.
            </h2>

            <p>
                Discover products, compare your favorite items, check customer reviews,
                and find your recommended size in one interactive shopping experience.
            </p>

            <div class="smart-hero-actions">
                <a href="#productsContainer" class="smart-primary-btn">
                    Start Exploring
                </a>

                <span class="smart-secondary-text">
                    Scroll, compare, and choose confidently.
                </span>
            </div>

            <div class="smart-hero-stats">
                <div>
                    <strong>Size</strong>
                    <span>Recommendation</span>
                </div>

                <div>
                    <strong>Product</strong>
                    <span>Compare</span>
                </div>

                <div>
                    <strong>Real</strong>
                    <span>Reviews</span>
                </div>
            </div>
        </div>

        <div class="smart-hero-visual">

            <div class="floating-feature feature-one">
                📏 Smart Size
            </div>

            <div class="floating-feature feature-two">
                ⭐ Reviews
            </div>

            <div class="floating-feature feature-three">
                ⇄ Compare
            </div>

            <div class="hero-glow-circle"></div>

            <div class="hero-main-card">
                <div class="hero-card-icon">👕</div>
                <h3>Smart Store</h3>
                <p>Personalized fashion experience</p>
            </div>

        </div>

    </div>

    <div class="smart-marquee">
        <div class="smart-marquee-track">
            <span>🔥 New Arrivals</span>
            <span>📏 Size Recommendation</span>
            <span>⇄ Product Compare</span>
            <span>⭐ Customer Reviews</span>
            <span>👕 Complete The Look</span>
            <span>♥ My Favorites</span>
            <span>🛒 Easy Shopping</span>

            <span>🔥 New Arrivals</span>
            <span>📏 Size Recommendation</span>
            <span>⇄ Product Compare</span>
            <span>⭐ Customer Reviews</span>
            <span>👕 Complete The Look</span>
            <span>♥ My Favorites</span>
            <span>🛒 Easy Shopping</span>
        </div>
    </div>

    <div class="filters-bar">

        <div class="filter-group">
            <label for="heightInput">Height</label>
            <input asp-for="Height" id="heightInput" class="filter-input" placeholder="Height in cm" />
        </div>

        <div class="filter-group">
            <label for="weightInput">Weight</label>
            <input asp-for="Weight" id="weightInput" class="filter-input" placeholder="Weight in kg" />
        </div>

        <div class="filter-group">
            <label for="ageInput">Age</label>
            <input asp-for="Age" id="ageInput" class="filter-input" placeholder="Your age" />
        </div>

        <div class="filter-group">
            <label for="categorySelect">Category</label>
            <select id="categorySelect" class="filter-input">
                <option value="">All Categories</option>
                @foreach (var category in Model.CategoriesList)
                {
                    <option value="@category.Value">@category.Text</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="genderSelect">Gender</label>
            <select id="genderSelect" class="filter-input">
                <option value="">All</option>
                <option value="Men">Men</option>
                <option value="Women">Women</option>
                <option value="Boys">Boys</option>
                <option value="Girls">Girls</option>
            </select>
        </div>

    </div>

    <div id="recommendedSizeBox" class="recommended-size-box"></div>

    <div id="productsLoading" class="products-loading">
        <div class="loading-spinner"></div>
        <span>Finding the best products for you...</span>
    </div>

    <div id="productsContainer" class="products-grid">

        @if (Model.Products != null && Model.Products.Any())
        {
            @foreach (var product in Model.Products)
            {
                <div class="product-card-wrapper">

                    <a href="/Customer/Home/Details/@product.Id?height=@Model.Height&weight=@Model.Weight&age=@Model.Age"
                       class="product-card-link">

                        <div class="customer-product-card">

                            <div class="customer-product-image" style="position:relative;">
                                <span class="gender-badge">@product.Gender</span>
                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/category-placeholder.png" : product.ImageUrl)" />
                            </div>

                            <div class="customer-product-body">

                                <div class="customer-product-category">@product.CategoryName</div>

                                <div class="customer-product-name">@product.Name</div>

                                <div style="margin:6px 0; font-size:13px;">

                                    @if (product.ReviewsCount > 0)
                                    {
                                        <div>
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span style="color:@(i <= Math.Round(product.AverageRating) ? "gold" : "#ddd"); font-size:14px;">
                                                    ★
                                                </span>
                                            }
                                        </div>

                                        <small style="color:gray;">
                                            @product.AverageRating.ToString("0.0") / 5
                                            (@product.ReviewsCount review@(product.ReviewsCount > 1 ? "s" : ""))
                                        </small>
                                    }
                                    else
                                    {
                                        <small style="color:gray;">No reviews yet</small>
                                    }

                                </div>

                                <div class="customer-product-price">
                                    $@product.Price.ToString("0.00")
                                </div>

                            </div>

                        </div>

                    </a>

                    <button type="button"
                            class="favorite-btn @(product.IsFavorite ? "active" : "")"
                            data-product-id="@product.Id"
                            title="Add to favorites">
                        @(product.IsFavorite ? "♥" : "♡")
                    </button>

                    <button type="button"
                            class="compare-btn"
                            data-product-id="@product.Id">
                        ⇄ Compare
                    </button>

                </div>
            }
        }
        else
        {
            <div class="empty-products">
                <h3>No Products Found</h3>
                <p>No products match your current filters.</p>
            </div>
        }

    </div>

</section>

<div class="compare-floating-bar" id="compareFloatingBar">
    <div>
        <strong id="compareCountText">0 products selected</strong>
        <span>Choose up to 3 products to compare.</span>
    </div>

    <div class="compare-actions">
        <button type="button" id="clearCompareBtn">
            Clear
        </button>

        <button type="button" id="goCompareBtn">
            Compare Selected
        </button>
    </div>
</div>

<div class="quick-actions-panel">
    <button type="button" id="quickCompareBtn" title="Compare Selected">
        ⇄
    </button>

    <button type="button" id="scrollTopBtn" title="Back To Top">
        ↑
    </button>
</div>

<style>
